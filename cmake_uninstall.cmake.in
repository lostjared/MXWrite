if(NOT EXISTS "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
  message(FATAL_ERROR "Cannot find install manifest: @CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
endif()

file(READ "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt" files)
string(REGEX REPLACE "\n" ";" files "${files}")

foreach(file ${files})
  if(file STREQUAL "")
    continue()
  endif()

  set(installed_path "$ENV{DESTDIR}${file}")
  message(STATUS "Uninstalling ${installed_path}")

  if(IS_SYMLINK "${installed_path}" OR EXISTS "${installed_path}")
    execute_process(
      COMMAND "@CMAKE_COMMAND@" -E remove "${installed_path}"
      RESULT_VARIABLE rm_retval
    )
    if(NOT rm_retval EQUAL 0)
      message(FATAL_ERROR "Problem when removing ${installed_path}")
    endif()
  else()
    message(STATUS "File ${installed_path} does not exist.")
  endif()
endforeach()
